---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import EventCalendar from '../components/EventCalendar.astro';
import zeffyData from '../data/zeffy-events.json';
import { buildEventOccurrences } from '../utils/eventListings';
import { publicAsset } from '../utils/publicAsset';

const classEntries = await getCollection('classes');
const events = buildEventOccurrences(classEntries, zeffyData);
const page = await getEntry('pages', 'classes');
if (!page) throw new Error('Missing classes page content');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}` || '/';
const statusLabel = {
  upcoming: 'Open',
  'sold-out': 'Sold out',
  cancelled: 'Cancelled',
  'coming-soon': 'Registration coming soon',
};
const fallbackImage = `${import.meta.env.BASE_URL}images/class-wheel.webp`;
const imageSource = (image?: string) => image
  ? (/^https?:\/\//i.test(image) ? image : publicAsset(image))
  : fallbackImage;
---

<BaseLayout title={page.data.title} active="classes" description={page.data.description}>
  <section class="classes-intro page-shell section--compact">
    <div class="classes-intro__copy">
      <h1 class="page-heading">{page.data.headingLine1}<br />{page.data.headingLine2}</h1>
      <p class="lead">{page.data.intro}</p>
      <a class="text-link" href="#schedule">Browse the schedule <ArrowIcon direction="down" /></a>
    </div>
    <figure class="classes-intro__image media-frame">
      <img src={`${import.meta.env.BASE_URL}images/class-wheel.webp`} alt="Artist smiling while working at a pottery wheel in CASA's ceramics studio" />
    </figure>
  </section>

  <div class="calendar-shell page-shell section--compact">
    <EventCalendar events={events} />
  </div>

  <section class="event-list page-shell section--compact" id="schedule" aria-labelledby="event-list-title">
    <div class="event-list__heading">
      <p class="eyeless-label">Schedule</p>
      <h2 id="event-list-title">Classes and events</h2>
      <p>Classes, workshops and community gatherings—organized chronologically and connected directly to registration when required.</p>
    </div>
    {events.length > 0 ? (
      <div class="event-list__rows">
        {events.map((event) => (
          <article class="event-row" id={event.id}>
            <figure class="event-row__thumbnail media-frame">
              <img src={imageSource(event.image)} alt={event.imageAlt || ''} loading="lazy" />
            </figure>
            <div class="event-row__date">
              <span>{event.kind}</span>
              <strong>{event.dateLabel}</strong>
            </div>
            <div class="event-row__main">
              <h3>{event.title}</h3>
              <p>{event.summary}</p>
            </div>
            <dl class="event-row__details">
              <div><dt>Time</dt><dd>{event.timeLabel}</dd></div>
              {event.instructor && <div><dt>Led by</dt><dd>{event.instructor}</dd></div>}
              {event.location && <div><dt>Location</dt><dd>{event.location}</dd></div>}
              {event.price && <div><dt>Price</dt><dd>{event.price}</dd></div>}
            </dl>
            <p class="event-row__status">{statusLabel[event.status]}</p>
            <div class="event-row__action">
              {event.registrationUrl && event.status === 'upcoming' ? (
                <a class="button button--red" href={event.registrationUrl} target="_blank" rel="noreferrer">Register</a>
              ) : event.status !== 'cancelled' && event.status !== 'sold-out' ? (
                <a class="button" href={`${href('/contact/')}?interest=classes&class=${encodeURIComponent(event.title)}`}>Ask about it</a>
              ) : null}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="event-list__empty">
        <p>New classes and events are being prepared. Contact CASA to hear what is coming next.</p>
        <a class="button button--red" href={`${href('/contact/')}?interest=classes`}>Contact CASA</a>
      </div>
    )}
  </section>

  <section class="class-help black-band" id="registration">
    <div class="page-shell class-help__inner">
      <div class="class-help__copy">
        <h2>Not sure where to begin?</h2>
        <p>We’re happy to help you find the right class, event or path. Reach out with your questions.</p>
        <a class="button button--dark" href={`${href('/contact/')}?interest=classes`}>Ask CASA</a>
      </div>
      <figure class="class-help__image media-frame">
        <img src={`${import.meta.env.BASE_URL}images/class-teen.webp`} alt="Young artist working with clay at CASA" loading="lazy" />
      </figure>
    </div>
  </section>
  <div class="registration-note page-shell">
    <p>Registration and payment are securely handled through Zeffy. CASA does not store payment information on this website.</p>
  </div>
</BaseLayout>

<style>
  .classes-intro { display: grid; grid-template-columns: minmax(310px, 0.7fr) minmax(560px, 1.3fr); align-items: center; gap: clamp(3rem, 6vw, 7rem); }
  .classes-intro__copy .lead { margin: 2rem 0; max-width: 34rem; }
  .classes-intro__image { aspect-ratio: 16 / 6.2; }
  .classes-intro__image img { object-position: center 22%; }
  .calendar-shell { padding-top: 0; }
  .event-list { border-top: 1px solid var(--red); }
  .event-list__heading { display: grid; grid-template-columns: minmax(230px, 0.7fr) minmax(320px, 1fr) minmax(320px, 1fr); align-items: end; gap: 2rem; margin-bottom: 2.5rem; }
  .event-list__heading .eyeless-label { margin: 0; color: var(--red); }
  .event-list__heading h2 { margin: 0; font-size: clamp(2rem, 3.4vw, 3.8rem); }
  .event-list__heading > p:last-child { max-width: 42rem; margin: 0; color: var(--gray-700); }
  .event-list__rows { border-top: 1px solid var(--black); }
  .event-row { display: grid; grid-template-columns: 140px 150px minmax(250px, 1.15fr) minmax(260px, 1.1fr) 110px 150px; align-items: center; gap: clamp(1rem, 1.7vw, 1.8rem); border-bottom: var(--line); padding-block: 1.2rem; scroll-margin-top: 96px; }
  .event-row:target { background: linear-gradient(90deg, rgb(255 0 0 / 7%), transparent 58%); }
  .event-row__thumbnail { width: 140px; aspect-ratio: 1; }
  .event-row p, .event-row dl { margin: 0; }
  .event-row__date { display: grid; gap: 0.35rem; }
  .event-row__date span { color: var(--red); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .event-row__date strong, .event-row__status { font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; text-transform: uppercase; }
  .event-row__main h3 { margin-bottom: 0.4rem; font-size: 1.15rem; font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; }
  .event-row__main p { color: var(--gray-700); font-size: 1rem; line-height: 1.35; }
  .event-row__details { display: grid; gap: 0.25rem; color: var(--gray-700); font-size: 0.92rem; }
  .event-row__details div { display: grid; grid-template-columns: 66px 1fr; gap: 0.7rem; }
  .event-row__details dt { color: var(--black); font-weight: 600; }
  .event-row__details dd { margin: 0; }
  .event-row__action { min-width: 0; }
  .event-row__action .button { width: 100%; min-height: 2.8rem; padding-inline: 0.7rem; }
  .event-list__empty { display: flex; align-items: center; justify-content: space-between; gap: 2rem; border-top: 1px solid var(--black); border-bottom: var(--line); padding: 2rem 0; }
  .event-list__empty p { margin: 0; }
  .class-help__inner { display: grid; grid-template-columns: minmax(320px, 0.85fr) minmax(520px, 1.15fr); min-height: 410px; align-items: stretch; }
  .class-help__copy { display: flex; align-items: flex-start; flex-direction: column; justify-content: center; padding: clamp(3rem, 6vw, 6rem) clamp(3rem, 7vw, 8rem) clamp(3rem, 6vw, 6rem) 0; }
  .class-help__copy h2 { margin-bottom: 1.2rem; font-size: var(--h2); color: var(--white); }
  .class-help__copy p { max-width: 35rem; margin-bottom: 2rem; color: var(--gray-200); }
  .class-help__image { min-height: 410px; }
  .registration-note { padding-block: 1rem; color: var(--gray-700); font-size: 1rem; }
  @media (max-width: 1180px) {
    .event-row { grid-template-columns: 120px 130px minmax(240px, 1fr) minmax(240px, 1fr) 120px; }
    .event-row__thumbnail { width: 120px; }
    .event-row__action { grid-column: 5; grid-row: 2; }
    .event-row__status { text-align: right; }
  }
  @media (max-width: 900px) {
    .classes-intro, .class-help__inner { grid-template-columns: 1fr; }
    .classes-intro__image { width: 100%; height: 360px; min-height: 0; aspect-ratio: auto; }
    .event-list__heading { grid-template-columns: 1fr 1fr; }
    .event-list__heading .eyeless-label { grid-column: 1 / -1; }
    .class-help__copy { padding-right: 0; }
    .class-help__image { min-height: 360px; }
    .event-row { grid-template-columns: 110px 1fr 130px; gap: 0.7rem 1.2rem; }
    .event-row__thumbnail { grid-column: 1; grid-row: 1 / 4; width: 110px; }
    .event-row__date { grid-column: 2; grid-row: 1; }
    .event-row__main { grid-column: 2 / -1; grid-row: 2; }
    .event-row__details { grid-column: 2 / -1; grid-row: 3; }
    .event-row__status { grid-column: 3; grid-row: 1; }
    .event-row__action { grid-column: 2 / -1; grid-row: auto; }
    .event-row__action .button { width: auto; }
  }
  @media (max-width: 580px) {
    .event-list__heading { grid-template-columns: 1fr; }
    .event-row { grid-template-columns: 96px 1fr; padding-block: 1.6rem; }
    .event-row__thumbnail { grid-column: 1; grid-row: 1 / 3; width: 96px; }
    .event-row__date { grid-column: 2; grid-row: 1; }
    .event-row__main { grid-column: 2; grid-row: 2; }
    .event-row__details, .event-row__status, .event-row__action { grid-column: 1 / -1; grid-row: auto; text-align: left; }
    .event-row__status { color: var(--gray-700); }
    .event-row__action .button { width: 100%; }
    .event-list__empty { align-items: stretch; flex-direction: column; }
  }
</style>
