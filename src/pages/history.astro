---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}` || '/';
---

<BaseLayout
  title="Our history"
  active="about"
  description="The founding story of Creative Artists’ Studios of Ames—and an invitation to help complete CASA’s history."
>
  <section class="history-hero page-shell section--compact">
    <h1 class="page-heading">A history of<br />making together.</h1>
    <div class="history-hero__intro">
      <p class="lead">CASA grew from a practical need and a shared belief: artists need room to work, learn and exchange what they know.</p>
      <p>This page begins with the founding account preserved on CASA’s earlier website. The people, programs and milestones from the decades since 2001 are still waiting to be added.</p>
    </div>
  </section>

  <section class="history-record page-shell section--compact" aria-labelledby="history-record-title">
    <div class="history-record__heading">
      <p class="history-record__year">2001</p>
      <h2 id="history-record-title">A beginning,<br />not an ending.</h2>
    </div>
    <div class="history-timeline">
      <article class="history-entry">
        <p class="history-entry__date">The first idea</p>
        <h3>It started with a clay class.</h3>
        <p>A group taking Mary Weisgram’s clay class at the Octagon Art Center realized that their work needed continuing access to a studio more than additional instruction. At the same time, one participant learned that his church had purchased a building and was seeking nonprofit tenants.</p>
      </article>
      <article class="history-entry">
        <p class="history-entry__date">A shared home</p>
        <h3>CASA becomes a nonprofit.</h3>
        <p>The artists formed a nonprofit corporation and rented space in a former Baptist church owned by Collegiate United Methodist Church—creating a permanent place to work alongside one another.</p>
      </article>
      <article class="history-entry">
        <p class="history-entry__date">January 1, 2001</p>
        <h3>The first artist moves in.</h3>
        <p>For its first six months, CASA occupied the top floor: two large rooms and seven smaller studios that gradually welcomed painters and fiber artists. The larger rooms supported shared work, exhibitions and, for a time, a small shop.</p>
      </article>
      <article class="history-entry">
        <p class="history-entry__date">Summer 2001</p>
        <h3>Clay studios take root.</h3>
        <p>CASA expanded into the building’s basement and established its clay studios. Later that year, the organization released the top-floor space and continued building a multidisciplinary home for artists in Ames.</p>
      </article>
    </div>
  </section>

  <section class="history-open page-shell section--compact" aria-labelledby="history-open-title">
    <div>
      <p class="history-open__label">2001—today</p>
      <h2 id="history-open-title">The next chapters are still being written.</h2>
    </div>
    <div class="history-open__copy">
      <p>CASA’s history is a living story, shaped by the artists, teachers, volunteers and neighbors who make it what it is. A fuller year-by-year chronology will grow here as CASA provides milestones, memories and historical photographs from the past 25 years.</p>
      <p>Know a part of the story that should be included?</p>
      <a class="text-link" href={href('/contact/')}>Share a memory with CASA <ArrowIcon /></a>
    </div>
  </section>

  <section class="history-cta black-band">
    <div class="page-shell history-cta__inner">
      <h2>Ready to become part of CASA’s next chapter?</h2>
      <div class="history-cta__actions">
        <a class="button button--red" href={href('/classes/')}>Take a class</a>
        <a class="button button--red" href={href('/studio-space/')}>Find studio space</a>
        <a class="button button--red" href={href('/contact/')}>Connect with us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .history-hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(340px, 0.7fr); align-items: end; gap: clamp(3rem, 8vw, 10rem); }
  .history-hero__intro { padding-bottom: 0.55rem; }
  .history-hero__intro .lead { margin-bottom: 1.5rem; }
  .history-hero__intro > p:last-child { max-width: 40rem; color: var(--gray-700); }
  .history-record { display: grid; grid-template-columns: minmax(240px, 0.55fr) minmax(0, 1.45fr); gap: clamp(3rem, 8vw, 9rem); border-top: var(--line); }
  .history-record__heading { position: sticky; top: 124px; align-self: start; }
  .history-record__year { margin-bottom: 1.25rem; color: var(--red); font-size: clamp(3.7rem, 7vw, 7rem); font-weight: 600; letter-spacing: -0.07em; line-height: 0.85; }
  .history-record__heading h2 { margin: 0; font-size: clamp(1.35rem, 2.2vw, 2.15rem); line-height: 1.05; }
  .history-timeline { border-top: 1px solid var(--black); }
  .history-entry { display: grid; grid-template-columns: minmax(120px, 0.35fr) minmax(0, 1fr); column-gap: clamp(1.5rem, 4vw, 4rem); border-bottom: var(--line); padding-block: clamp(2rem, 4vw, 3.75rem); }
  .history-entry__date { grid-row: 1 / span 2; margin: 0; font-size: 1rem; font-weight: 700; letter-spacing: 0.045em; text-transform: uppercase; }
  .history-entry h3 { margin-bottom: 0.9rem; font-size: clamp(1.7rem, 3vw, 3rem); line-height: 1; }
  .history-entry > p:last-child { max-width: 48rem; margin: 0; color: var(--gray-700); }
  .history-open { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(340px, 0.8fr); gap: clamp(3rem, 8vw, 9rem); border-top: 1px solid var(--red); }
  .history-open__label { margin-bottom: 1.2rem; color: var(--red); font-size: 1rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .history-open h2 { max-width: 48rem; margin: 0; font-size: var(--h2); }
  .history-open__copy { align-self: end; }
  .history-open__copy p { color: var(--gray-700); }
  .history-open__copy .text-link { margin-top: 0.5rem; }
  .history-cta__inner { padding-block: clamp(4rem, 7vw, 7rem); }
  .history-cta h2 { max-width: 72rem; margin-bottom: clamp(2.5rem, 4vw, 4rem); font-size: var(--h2); }
  .history-cta__actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .history-cta__actions .button { border-color: var(--red); }
  .history-cta__actions .button:hover { border-color: var(--white); background: var(--white); color: var(--black); }
  @media (max-width: 900px) {
    .history-hero, .history-record, .history-open { grid-template-columns: 1fr; }
    .history-record__heading { position: static; }
  }
  @media (max-width: 640px) {
    .history-entry { grid-template-columns: 1fr; }
    .history-entry__date { grid-row: auto; margin-bottom: 1rem; }
    .history-cta__actions { grid-template-columns: 1fr; }
  }
</style>
