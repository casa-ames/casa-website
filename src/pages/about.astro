---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { publicAsset } from '../utils/publicAsset';

const gallery = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
const externalGalleries = (await getCollection('externalGalleries'))
  .filter(({ data }) => data.visible)
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data }) => data);
const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing about page content');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}` || '/';
const featuredGallery = gallery.filter(({ data }) => data.featured).map(({ data }) => data);
const heroPhoto = featuredGallery[0];
const storyPhotos = featuredGallery.slice(1);
---

<BaseLayout title={page.data.title} active="about" description={page.data.description}>
  <section class="about-intro page-shell section--compact">
    <div class="about-intro__copy">
      <h1 class="page-heading">{page.data.headingLine1}<br />{page.data.headingLine2}</h1>
      <p class="lead">{page.data.intro}</p>
    </div>
    {heroPhoto && (
      <figure class="about-intro__media">
        <div class="about-intro__image media-frame">
          <img src={publicAsset(heroPhoto.image)} alt={heroPhoto.alt} style={`object-position: ${heroPhoto.focusX}% ${heroPhoto.focusY}%`} />
        </div>
        <figcaption class="caption">{heroPhoto.caption}</figcaption>
      </figure>
    )}
  </section>

  <section class="about-story page-shell section--compact" aria-labelledby="story-title">
    {storyPhotos.length > 0 && (
      <div class="about-story__gallery">
        {storyPhotos.map((photo) => (
          <figure class:list={['about-story__photo', {
            'about-story__photo--history': photo.category === 'history',
            'about-story__photo--wheel': photo.image === '/images/class-wheel.webp',
          }]}>
            <div class="about-story__image media-frame">
              <img src={publicAsset(photo.image)} alt={photo.alt} loading="lazy" style={`object-position: ${photo.focusX}% ${photo.focusY}%`} />
            </div>
            <figcaption class="caption">{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
    )}
    <div class="about-story__copy">
      <h2 id="story-title">Our story</h2>
      <p>For more than 25 years, CASA has made space for artists at every stage—supporting affordable studio access, approachable classes and opportunities to show and connect.</p>
      <p>What began as a small group of artists with a shared vision has grown into a vital creative community in Ames. <a class="story-link" href={href('/history/')}>Follow CASA’s story through the years.</a></p>
      <p>We’re artists, teachers, makers, students, neighbors and friends. We show up, we share and we keep making.</p>
      <a class="text-link" href={href('/contact/')}>Connect with CASA <ArrowIcon /></a>
    </div>
  </section>

  <section class="supporters page-shell section--compact" aria-labelledby="supporters-title">
    <div class="supporters__copy">
      <p class="eyebrow">Major supporters</p>
      <h2 id="supporters-title">Made possible together.</h2>
      <p>Supported in part through local option tax funds provided by the City of Ames through the Commission on the Arts.</p>
    </div>
    <div class="supporters__logos" aria-label="Supporting organizations">
      <a href="https://www.cityofames.org/" target="_blank" rel="noreferrer" aria-label="Visit the City of Ames website">
        <img src={publicAsset('/images/supporters/city-of-ames.svg')} alt="City of Ames" width="260" height="100" loading="lazy" />
      </a>
      <a href="https://www.cityofames.org/My-Government/Departments/City-Managers-Office/Commission-on-the-Arts" target="_blank" rel="noreferrer" aria-label="Visit the City of Ames Commission on the Arts website">
        <img src={publicAsset('/images/supporters/commission-on-the-arts.webp')} alt="Ames Commission on the Arts" width="1100" height="331" loading="lazy" />
      </a>
    </div>
  </section>

  {externalGalleries.length > 0 && (
    <section class="external-galleries page-shell section--compact" aria-labelledby="external-galleries-title">
      <div class="external-galleries__heading">
        <p class="eyebrow">Beyond the studio</p>
        <h2 id="external-galleries-title">Explore more CASA work</h2>
        <p>Exhibitions, publications and collections that extend CASA’s story beyond this website.</p>
      </div>
      <div class="external-galleries__list">
        {externalGalleries.map((item) => (
          <article class="external-gallery">
            <a class="external-gallery__thumbnail media-frame" href={item.url} target="_blank" rel="noreferrer" aria-label={`${item.linkLabel}: ${item.title}`}>
              <img src={publicAsset(item.image)} alt={item.imageAlt} loading="lazy" style={`object-position: ${item.focusX}% ${item.focusY}%`} />
            </a>
            <div class="external-gallery__copy">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a class="text-link" href={item.url} target="_blank" rel="noreferrer">{item.linkLabel} <ArrowIcon /></a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="about-cta page-shell section--compact">
    <h2>Come make something with us.</h2>
    <a class="text-link" href={href('/contact/')}>Contact <ArrowIcon /></a>
  </section>
</BaseLayout>

<style>
  .about-intro { display: grid; grid-template-columns: minmax(330px, 0.85fr) minmax(560px, 1.3fr); align-items: center; gap: clamp(3rem, 6vw, 7rem); }
  .about-intro__copy .lead { margin: 2.6rem 0 0; max-width: 33rem; }
  .about-intro__media, .about-story__photo { min-width: 0; margin: 0; }
  .about-intro__image { aspect-ratio: 16 / 7.1; }
  .about-intro__image img { object-position: center; }
  .about-story { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(300px, 0.75fr); gap: clamp(3rem, 6vw, 7rem); border-top: var(--line); }
  .about-story__gallery { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 1.25rem; }
  .about-story__image { aspect-ratio: 4 / 3; }
  .about-story__photo--wheel .about-story__image { aspect-ratio: 1.05 / 1; }
  .about-story__photo--history { grid-column: 1 / -1; }
  .about-story__photo--history .about-story__image { aspect-ratio: 16 / 6.5; }
  .about-story__copy { align-self: center; }
  .about-story__copy h2 { margin-bottom: 2rem; font-size: var(--h2); }
  .about-story__copy p { color: var(--gray-700); }
  .about-story__copy .text-link { margin-top: 1rem; }
  .story-link { color: var(--red); font-weight: 500; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .story-link:hover { color: var(--black); }
  .supporters { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(420px, 0.65fr); align-items: center; gap: clamp(3rem, 7vw, 8rem); border-top: var(--line); }
  .supporters__copy .eyebrow { margin-bottom: 1rem; color: var(--red); font-size: 1rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .supporters__copy h2 { margin-bottom: 1.3rem; font-size: var(--h2); }
  .supporters__copy > p:last-child { max-width: 54rem; margin-bottom: 0; color: var(--gray-700); font-size: clamp(1.1rem, 1.45vw, 1.4rem); line-height: 1.45; }
  .supporters__logos { display: grid; grid-template-columns: minmax(130px, 0.75fr) minmax(220px, 1.25fr); align-items: center; gap: clamp(1.5rem, 3vw, 3rem); }
  .supporters__logos a { display: grid; min-height: 130px; place-items: center; border-left: var(--line); padding-left: clamp(1.5rem, 3vw, 3rem); }
  .supporters__logos img { width: 100%; height: auto; max-height: 104px; object-fit: contain; filter: grayscale(1); transition: filter var(--motion), opacity var(--motion); }
  .supporters__logos a:first-child img { max-width: 210px; }
  .supporters__logos a:hover img { filter: grayscale(0); opacity: 0.78; }
  .external-galleries { display: grid; grid-template-columns: minmax(260px, 0.55fr) minmax(0, 1.45fr); gap: clamp(3rem, 7vw, 8rem); border-top: var(--line); border-bottom: var(--line); }
  .external-galleries__heading .eyebrow { margin-bottom: 1rem; color: var(--red); font-size: 1rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .external-galleries__heading h2 { margin-bottom: 1.2rem; font-size: var(--h2); }
  .external-galleries__heading > p:last-child { max-width: 31rem; color: var(--gray-700); }
  .external-galleries__list { border-top: var(--line); }
  .external-gallery { display: grid; grid-template-columns: minmax(150px, 0.45fr) minmax(0, 1.55fr); gap: clamp(1.5rem, 3vw, 3rem); border-bottom: var(--line); padding-block: 1.5rem; }
  .external-gallery__thumbnail { aspect-ratio: 4 / 3; }
  .external-gallery__thumbnail img { transition: transform var(--motion); }
  .external-gallery__thumbnail:hover img { transform: scale(1.025); }
  .external-gallery__copy { align-self: center; }
  .external-gallery__copy h3 { margin-bottom: 0.55rem; font-size: clamp(1.35rem, 2vw, 2rem); }
  .external-gallery__copy p { max-width: 46rem; margin-bottom: 0.8rem; color: var(--gray-700); }
  .about-cta { display: flex; align-items: baseline; justify-content: space-between; gap: 3rem; }
  .about-cta h2 { margin: 0; font-size: var(--h2); }
  @media (max-width: 940px) {
    .about-intro, .about-story, .supporters, .external-galleries { grid-template-columns: 1fr; }
    .about-intro__image { width: 100%; height: 360px; min-height: 0; aspect-ratio: auto; }
    .about-story__copy { grid-row: 1; }
    .supporters__logos { max-width: 660px; }
  }
  @media (max-width: 620px) {
    .about-story__gallery { grid-template-columns: 1fr; }
    .about-story__photo--history { grid-column: 1; width: 100%; }
    .about-story__photo--history .about-story__image { height: 240px; min-height: 0; aspect-ratio: auto; }
    .supporters__logos { grid-template-columns: 1fr; align-items: start; gap: 1.5rem; }
    .supporters__logos a { min-height: 0; justify-items: start; border-left: 0; border-top: var(--line); padding: 1.5rem 0 0; }
    .supporters__logos img { max-width: 320px; max-height: 90px; object-position: left center; }
    .supporters__logos a:first-child img { max-width: 190px; }
    .external-gallery { grid-template-columns: minmax(110px, 34%) 1fr; }
    .about-cta { align-items: flex-start; flex-direction: column; }
  }
</style>
