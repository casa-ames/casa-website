---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { site } from '../config/site';

const gallery = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing about page content');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}` || '/';
const featured = gallery.find(({ data }) => data.caption.startsWith('Open studio'))?.data;
const history = gallery.find(({ data }) => data.category === 'history')?.data;
const artwork = gallery.find(({ data }) => data.category === 'artwork')?.data;
---

<BaseLayout title={page.data.title} active="about" description={page.data.description}>
  <section class="about-intro page-shell section--compact">
    <div class="about-intro__copy">
      <h1 class="page-heading">{page.data.headingLine1}<br />{page.data.headingLine2}</h1>
      <p class="lead">{page.data.intro}</p>
    </div>
    {featured && (
      <figure class="about-intro__media media-frame">
        <img src={`${import.meta.env.BASE_URL}${featured.image.replace(/^\//, '')}`} alt={featured.alt} />
        <figcaption class="caption">{featured.caption}</figcaption>
      </figure>
    )}
  </section>

  <section class="about-story page-shell section--compact" aria-labelledby="story-title">
    <div class="about-story__gallery">
      {history && (
        <figure class="about-story__history media-frame">
          <img src={`${import.meta.env.BASE_URL}${history.image.replace(/^\//, '')}`} alt={history.alt} loading="lazy" />
          <figcaption class="caption">{history.caption}</figcaption>
        </figure>
      )}
      <figure class="about-story__work media-frame">
        <img src={`${import.meta.env.BASE_URL}images/gallery-making.webp`} alt="Artist working with materials on a shared CASA studio table" loading="lazy" />
        <figcaption class="caption">Studio work in progress</figcaption>
      </figure>
      {artwork && (
        <figure class="about-story__art media-frame">
          <img src={`${import.meta.env.BASE_URL}${artwork.image.replace(/^\//, '')}`} alt={artwork.alt} loading="lazy" />
          <figcaption class="caption">{artwork.caption}</figcaption>
        </figure>
      )}
    </div>
    <div class="about-story__copy">
      <h2 id="story-title">Our story</h2>
      <p>For more than 25 years, CASA has made space for artists at every stage—supporting affordable studio access, approachable classes and opportunities to show and connect.</p>
      <p>What began as a small group of artists with a shared vision has grown into a vital creative community in Ames.</p>
      <p>We’re artists, teachers, makers, students, neighbors and friends. We show up, we share and we keep making.</p>
      <a class="text-link" href={href('/contact/')}>Connect with CASA <ArrowIcon /></a>
    </div>
  </section>

  <section class="publication page-shell section--compact" aria-labelledby="publication-title">
    <div class="publication__mark" aria-hidden="true">
      <span>25</span>
      <span>YEARS<br />OF<br />CASA</span>
    </div>
    <div class="publication__copy">
      <h2 id="publication-title">CASA 25th Anniversary Exhibition</h2>
      <p>A celebration of twenty-five years of artists, classes and community, featuring work from generations of CASA artists.</p>
      <a class="text-link" href={site.publicationUrl} target="_blank" rel="noreferrer">View the photobook <ArrowIcon /></a>
    </div>
  </section>

  <section class="about-cta page-shell section--compact">
    <h2>Come make something with us.</h2>
    <a class="text-link" href={href('/contact/')}>Contact <ArrowIcon /></a>
  </section>
</BaseLayout>

<style>
  .about-intro { display: grid; grid-template-columns: minmax(330px, 0.85fr) minmax(560px, 1.3fr); align-items: center; gap: clamp(3rem, 6vw, 7rem); }
  .about-intro__copy .lead { margin: 2.6rem 0 0; max-width: 33rem; }
  .about-intro__media { overflow: visible; aspect-ratio: 16 / 7.1; }
  .about-intro__media img { object-position: center; }
  .about-story { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(300px, 0.75fr); gap: clamp(3rem, 6vw, 7rem); border-top: var(--line); }
  .about-story__gallery { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 1.25rem; }
  .about-story__gallery figure { overflow: visible; }
  .about-story__history { grid-column: 1 / -1; aspect-ratio: 16 / 6.5; }
  .about-story__work, .about-story__art { aspect-ratio: 4 / 3; }
  .about-story__copy { align-self: center; }
  .about-story__copy h2 { margin-bottom: 2rem; font-size: var(--h2); }
  .about-story__copy p { color: var(--gray-700); }
  .about-story__copy .text-link { margin-top: 1rem; }
  .publication { display: grid; grid-template-columns: 220px minmax(0, 1fr); align-items: center; gap: clamp(2.5rem, 5vw, 6rem); border-top: var(--line); border-bottom: var(--line); }
  .publication__mark { display: grid; aspect-ratio: 4 / 5; align-content: center; justify-items: center; border: var(--line); color: var(--black); }
  .publication__mark > span:first-child { font-size: 4rem; font-weight: 700; letter-spacing: -0.08em; line-height: 1; }
  .publication__mark > span:last-child { margin-top: 0.5rem; font-size: 0.8rem; font-weight: 700; line-height: 1.15; }
  .publication__copy { max-width: 700px; }
  .publication__copy h2 { margin-bottom: 1.2rem; font-size: clamp(2rem, 3vw, 3.5rem); }
  .publication__copy p { max-width: 45rem; color: var(--gray-700); }
  .about-cta { display: flex; align-items: baseline; justify-content: space-between; gap: 3rem; }
  .about-cta h2 { margin: 0; font-size: var(--h2); }
  @media (max-width: 940px) {
    .about-intro, .about-story { grid-template-columns: 1fr; }
    .about-intro__media { width: 100%; height: 360px; min-height: 0; aspect-ratio: auto; }
    .about-story__copy { grid-row: 1; }
  }
  @media (max-width: 620px) {
    .about-story__gallery { grid-template-columns: 1fr; }
    .about-story__history { grid-column: 1; width: 100%; height: 240px; min-height: 0; aspect-ratio: auto; }
    .publication { grid-template-columns: 110px 1fr; gap: 1.5rem; }
    .publication__mark > span:first-child { font-size: 2.7rem; }
    .about-cta { align-items: flex-start; flex-direction: column; }
  }
</style>
