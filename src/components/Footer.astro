---
import Logo from './Logo.astro';
import { site } from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}` || '/';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner page-shell">
    <a class="site-footer__brand" href={href('/')} aria-label="CASA home">
      <Logo id="footer" tone="gray" />
    </a>
    <nav class="site-footer__nav" aria-label="Footer navigation">
      <a href={href('/about/')}>About</a>
      <a href={href('/classes/')}>Classes</a>
      <a href={href('/studio-space/')}>Studio Space</a>
      <a href={href('/contact/')}>Contact</a>
    </nav>
    <p class="site-footer__meta">© {year} {site.shortName}</p>
  </div>
</footer>
