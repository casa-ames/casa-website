---
import Logo from './Logo.astro';
import { site } from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}` || '/';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner page-shell">
    <a class="site-footer__brand" href={href('/')} aria-label="CASA home">
      <Logo id="footer" variant="horizontal-white" />
    </a>
    <nav class="site-footer__nav" aria-label="Footer navigation">
      <a href={href('/about/')}>About</a>
      <a href={href('/classes/')}>Events</a>
      <a href={href('/studio-space/')}>Studio Space</a>
      <a href={href('/contact/')}>Contact</a>
    </nav>
    <div class="site-footer__end">
      <button class="site-footer__sitemap-button" type="button" aria-haspopup="dialog" data-sitemap-open>Sitemap</button>
      <nav class="site-footer__social" aria-label="CASA social media">
        <a href={site.social.facebook} target="_blank" rel="noreferrer" aria-label="CASA on Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 8.1V6.2c0-.9.6-1.1 1.1-1.1h2.8V.7L14.5.6c-4 0-5.1 3-5.1 5v2.5H6.7v4.5h2.7v10.8h5.1V12.6h3.7l.6-4.5h-4.3Z" /></svg>
        </a>
        <a href={site.social.instagram} target="_blank" rel="noreferrer" aria-label="CASA on Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5" /><circle cx="12" cy="12" r="4.4" /><circle cx="17.7" cy="6.4" r="1" class="instagram-dot" /></svg>
        </a>
      </nav>
      <p class="site-footer__meta">© {year} {site.shortName}</p>
      <p class="site-footer__credit">Web design by <a href="https://www.sebastiansanchez.net/" target="_blank" rel="noreferrer"><strong>© 2026 – Sebastian Sanchez-Falero</strong></a></p>
    </div>
  </div>
</footer>

<dialog class="sitemap-dialog" aria-labelledby="sitemap-title" data-sitemap-dialog>
  <div class="sitemap-dialog__panel">
    <div class="sitemap-dialog__header">
      <p class="eyeless-label">CASA Ames</p>
      <button class="sitemap-dialog__close" type="button" data-sitemap-close>
        <span>Close</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" /></svg>
      </button>
    </div>
    <h2 id="sitemap-title">Find your way.</h2>
    <nav class="sitemap-dialog__links" aria-label="Sitemap">
      <a href={href('/')}><span>01</span>Home</a>
      <a href={href('/about/')}><span>02</span>About CASA</a>
      <a href={href('/history/')}><span>03</span>CASA History</a>
      <a href={href('/classes/')}><span>04</span>Events &amp; Classes</a>
      <a href={href('/studio-space/')}><span>05</span>Studio Space</a>
      <a href={href('/contact/')}><span>06</span>Contact</a>
    </nav>
  </div>
</dialog>

<script>
  const sitemapDialog = document.querySelector<HTMLDialogElement>('[data-sitemap-dialog]');
  const sitemapOpen = document.querySelector<HTMLButtonElement>('[data-sitemap-open]');
  const sitemapClose = document.querySelector<HTMLButtonElement>('[data-sitemap-close]');

  sitemapOpen?.addEventListener('click', () => sitemapDialog?.showModal());
  sitemapClose?.addEventListener('click', () => sitemapDialog?.close());
  sitemapDialog?.addEventListener('click', (event) => {
    if (event.target === sitemapDialog) sitemapDialog.close();
  });
</script>
