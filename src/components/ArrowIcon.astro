---
interface Props {
  direction?: 'right' | 'down';
}

const { direction = 'right' } = Astro.props;
---

<svg
  class:list={["arrow-icon", { "arrow-icon--down": direction === 'down' }]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  <path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter" />
</svg>

<style>
  .arrow-icon { width: 1.25em; height: 1.25em; flex: 0 0 auto; }
  .arrow-icon--down { transform: rotate(90deg); }
</style>
