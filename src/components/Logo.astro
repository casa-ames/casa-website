---
interface Props {
  id: string;
  variant?: 'primary' | 'reverse' | 'white';
  label?: string;
  class?: string;
}

const {
  id,
  variant = 'primary',
  label = 'CASA — Creative Artists’ Studios of Ames',
  class: className = '',
} = Astro.props;
const sources = {
  primary: `${import.meta.env.BASE_URL}images/brand/casa-logo-primary.svg`,
  reverse: `${import.meta.env.BASE_URL}images/brand/casa-logo-reverse.svg`,
  white: `${import.meta.env.BASE_URL}images/brand/casa-logo-white.svg`,
};
---

<img
  id={`casa-logo-${id}`}
  class:list={["casa-logo", `casa-logo--${variant}`, className]}
  src={sources[variant]}
  alt={label}
  decoding="async"
/>

<style>
  .casa-logo { display: block; width: 100%; height: auto; }
</style>
