---
import type { EventOccurrence } from '../utils/eventListings';

interface Props {
  event: EventOccurrence;
  contactUrl: string;
  class?: string;
}

const { event, contactUrl, class: className } = Astro.props;
const isWebsiteOnlyEvent = event.source === 'website' && event.kind === 'Event';
---

<div class:list={['event-action', className]} data-event-action>
  {event.status === 'past' ? (
    <a class="button" href={contactUrl}>Ask a question</a>
  ) : event.registrationUrl && event.status === 'upcoming' ? (
    <a class="button button--red" href={event.registrationUrl} target="_blank" rel="noreferrer">Register</a>
  ) : isWebsiteOnlyEvent && event.status === 'upcoming' ? (
    <>
      <button class="button" type="button" data-join-dialog={event.id}>Join us</button>
      <dialog
        class="join-dialog"
        id={`join-${event.id}`}
        aria-labelledby={`join-${event.id}-title`}
      >
        <div class="join-dialog__content">
          <button class="join-dialog__close" type="button" data-close-dialog aria-label="Close message">×</button>
          <p class="eyeless-label">You’re invited</p>
          <h2 id={`join-${event.id}-title`}>No need to register, just join us for free!</h2>
          <p>
            Have a question about this event?{' '}
            <a href={contactUrl}>Contact us.</a>
          </p>
        </div>
      </dialog>
    </>
  ) : event.status !== 'cancelled' && event.status !== 'sold-out' ? (
    <a class="button" href={contactUrl}>Ask about it</a>
  ) : null}
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-join-dialog]').forEach((button) => {
    if (button.dataset.dialogReady === 'true') return;
    button.dataset.dialogReady = 'true';
    const eventId = button.dataset.joinDialog;
    const dialog = eventId ? document.getElementById(`join-${eventId}`) : null;
    if (!(dialog instanceof HTMLDialogElement)) return;

    button.addEventListener('click', () => dialog.showModal());
    dialog.querySelector<HTMLButtonElement>('[data-close-dialog]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .event-action { min-width: 0; }
  .event-action .button { width: 100%; min-height: 2.8rem; padding-inline: 0.7rem; }
  .join-dialog { width: min(92vw, 520px); max-width: none; border: 0; padding: 0; color: var(--black); box-shadow: 0 22px 70px rgb(0 0 0 / 24%); }
  .join-dialog::backdrop { background: rgb(0 0 0 / 42%); }
  .join-dialog__content { position: relative; padding: clamp(2.25rem, 6vw, 4rem); }
  .join-dialog__content .eyeless-label { margin: 0 0 1rem; color: var(--red); }
  .join-dialog__content h2 { max-width: 12ch; margin: 0 0 1.5rem; font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.08; }
  .join-dialog__content > p:last-child { margin: 0; color: var(--gray-700); }
  .join-dialog__content a { color: var(--black); text-decoration: underline; text-decoration-color: var(--red); text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .join-dialog__content a:hover { color: var(--red); }
  .join-dialog__close { position: absolute; top: 1rem; right: 1rem; display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border: 0; background: transparent; color: var(--black); font: inherit; font-size: 1.8rem; line-height: 1; cursor: pointer; }
  .join-dialog__close:hover { color: var(--red); }
</style>
